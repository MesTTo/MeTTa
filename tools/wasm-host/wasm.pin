# The emscripten toolchain and C dependencies the wasm host is built with, as
# data rather than prose, the way tools/pymetta-host/swipl.pin holds the SWI
# source. tools/wasm-host/build.sh is the only reader.
#
# Every version here is upstream's own: npm-swipl-wasm's build-config.json at
# the commit where it built THIS repository's pinned swipl-devel commit
# (69775434c8226897626b226aefcc8266499f1e2e, V10.1.14), released as
# npm swipl-wasm 8.1.2. Nothing here was chosen by us, because the question a
# build failure then answers is whether our patches broke the build rather
# than whether this version triple ever built this source.
#
# `docker/Dockerfile` in that repository is byte-identical between v8.0.6,
# which the seat used to depend on, and that commit, so the recipe
# tools/wasm-host/Dockerfile follows is one recipe rather than a version of it.
upstream    https://github.com/SWI-Prolog/npm-swipl-wasm.git
upstream_commit 774c700f2bae5c3f59706ad11dbfbd6d5f8af3e1
emsdk       6.0.9
zlib        1.3.2
pcre2       pcre2-10.48
#
# Ours, beside upstream's: the C libraries SWI's yaml and utf8proc packages
# link, which no swipl-wasm release builds. Each is the version the native
# host this tree runs on links (Debian's libyaml-0-2 0.2.5-2build3 and
# libutf8proc3 2.10.0-2, measured 2026-09-24 with dpkg -l), so both hosts
# answer the same: utf8proc 2.10.0 reports Unicode 16.0.0, which
# examples/ch08-data/08-03-the-shipped-libraries/26-unicode_lib.metta
# expects. The sha256 is of GitHub's archive of the tag, checked by the
# Dockerfile before the source is used. libarchive is not here: it is
# lib_compression's own pinned snapshot, in lib/lib_compression/vendor.
libyaml     0.2.5
libyaml_sha256 fa240dbf262be053f3898006d502d514936c818e422afdcf33921c63bed9bf2e
utf8proc    2.10.0
utf8proc_sha256 6f4f1b639daa6dca9f80bc5db1233e9cbaa31a67790887106160b33ef743f136
#
# OSSP UUID, which packages/clib's uuid binding links for version 1 UUIDs, at
# the release the native host this tree runs on links: 1.6.2, whose uuid.c is
# byte-identical to the native build's (measured 2026-09-24). OSSP's own
# server is gone, so the source is Debian's copy of that release, and the
# sha256 is the one Debian's ossp-uuid_1.6.2-1.5.dsc lists for it.
ossp_uuid   1.6.2
ossp_uuid_sha256 11a615225baa5f8bb686824423f50e4427acd3f70d394765bdff32801f0fd5b0
