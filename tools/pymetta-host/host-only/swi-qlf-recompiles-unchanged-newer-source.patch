+'$qlf_source_changed'(QlfFile, PlFile) :-
+    (   catch('$qlf_sources'(QlfFile, Sources), _, fail),
+	'$member'(source(PlFile, Hash), Sources),
+	Hash =\= 0
+    ->  \+ '$file_hash'(PlFile, Hash)
+    ;   true
+    ).
