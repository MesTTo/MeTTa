diff --git a/src/pl-alloc.c b/src/pl-alloc.c
index 5df9139..33999b2 100644
--- a/src/pl-alloc.c
+++ b/src/pl-alloc.c
@@ -708,8 +708,10 @@ outOfStack(void *stack, stack_overflow_action how)
 	p[1] = consPtr(&p[3], TAG_COMPOUND|STG_GLOBAL);
 	p[2] = ctx;
 	p[3] = FUNCTOR_resource_error1;
-	p[4] = ATOM_stack;
+	p[4] = LD->stacks.heap_refused ? ATOM_no_memory	/* malloc() said no, */
+				       : ATOM_stack;	/* not the limit */
 	gTop += 5;
+	LD->stacks.heap_refused = false;
 
 	*valTermRef(LD->exception.bin) = consPtr(p, TAG_COMPOUND|STG_GLOBAL);
 	freezeGlobal();
diff --git a/src/pl-gc.c b/src/pl-gc.c
index bd9b1fc..b681cde 100644
--- a/src/pl-gc.c
+++ b/src/pl-gc.c
@@ -5383,6 +5383,8 @@ grow_stacks(DECL_LD size_t l, size_t g, size_t t)
   if ( LD->shift_status.blocked )
     return false;
 
+  LD->stacks.heap_refused = false;
+
   if ( (rc=new_stack_size((Stack)&LD->stacks.trail,  t, &tsize))<0 ||
        (rc=new_stack_size((Stack)&LD->stacks.global, g, &gsize))<0 ||
        (rc=new_stack_size((Stack)&LD->stacks.local,  l, &lsize))<0 )
@@ -5593,8 +5595,10 @@ grow_stacks(DECL_LD size_t l, size_t g, size_t t)
   unblockSignals(&mask);
   leaveGC();
 
-  if ( fatal )
-    return fatal->overflow_id;
+  if ( fatal )				/* the heap refused, not the limit, */
+  { LD->stacks.heap_refused = true;	/* which was checked above: */
+    return fatal->overflow_id;		/* outOfStack() names memory */
+  }
 
   return true;
 }
diff --git a/src/pl-incl.h b/src/pl-incl.h
index 3e57750..f34c1ec 100644
--- a/src/pl-incl.h
+++ b/src/pl-incl.h
@@ -2460,6 +2460,7 @@ struct stack STACK(caddress);		/* Anonymous stack */
 
 typedef struct
 { size_t limit;				/* Total stack limit */
+  bool   heap_refused;			/* last growth: malloc() failed */
   struct STACK(LocalFrame) local;	/* local (environment) stack */
   struct STACK(Word)	   global;	/* local (environment) stack */
   struct STACK(TrailEntry) trail;	/* trail stack */
