+/* A saved PC at the end of an instruction normally means the instruction
+   is in progress: it requested stack space after reading its operands and
+   resumes with them, so the walk starts at the instruction and treats its
+   first-var operand as unwritten.  The instructions below write their
+   first-var operand and then call a predicate that returns to that same
+   PC (=/2, arg/3 and is/2 under the debugger, arg/3 when the inline arg
+   cannot answer), and they request space only before reading their
+   operands or with that operand holding a variable, so a saved PC at
+   their end is the return address of a completed instruction: the walk
+   starts after it, as it does for a parent frame's return address.
+   Starting at the instruction cleared the completed first-var slot when
+   a frame_finished listener collected at the exit of the debugger's
+   frame for =/2. */
+
+static bool
+returns_to_end_of_vmi(code op)
+{ switch(op)
+  { case B_UNIFY_FF:
+    case B_UNIFY_FV:
+    case B_UNIFY_VF:
+    case B_UNIFY_FC:
+    case B_ARG_CF:
+    case B_ARG_VF:
+    case A_ADD_FC:
+      return true;
+    default:
+      return false;
+  }
+}
+
 static void
 setStartOfVMI(vm_state *state)
 { LocalFrame fr = state->frame;
