+	      void *lb, void *gb, void *tb)
 { GET_LD
   intptr_t ls, gs, ts;
 
@@ -5199,6 +5254,12 @@ update_stacks(vm_state *state, void *lb, void *gb, void *tb)
 
     if ( gs || ls )
     { update_new_arguments(state, gs);
+      for(size_t i=0; i<parents->count; i++)
+      { vm_state *parent = &parents->states[i];
+
+	update_pointer(&parent->lNext, ls);
+	update_new_arguments(parent, gs);
+      }
       update_argument(ls, gs);
       update_trail(tb, ls, gs);
       update_global(gb, gs);
@@ -5370,6 +5431,7 @@ grow_stacks(DECL_LD size_t l, size_t g, size_t t)
 { sigset_t mask;
   size_t lsize=0, gsize=0, tsize=0;
   vm_state state;
+  parent_vm_states parents;
   Stack fatal = NULL;	/* stack we couldn't expand due to lack of memory */
   boolex_t rc;
 #if O_DEBUG
@@ -5454,6 +5516,7 @@ grow_stacks(DECL_LD size_t l, size_t g, size_t t)
   PL_clearsig(SIG_GC);
 
   get_vmi_state(LD->query, &state);
+  get_parent_vmi_states(&parents);
 
   { TrailEntry tb = tBase;
     Word gb = gBase;
@@ -5554,7 +5617,7 @@ grow_stacks(DECL_LD size_t l, size_t g, size_t t)
     }
 
     gBase++; gb++;
-    update_stacks(&state, lb, gb, tb);
+    update_stacks(&state, &parents, lb, gb, tb);
     gBase--; gb--;
 
     LD->stacks.local.max  = addPointer(LD->stacks.local.base,  lsize);
@@ -5591,6 +5654,7 @@ grow_stacks(DECL_LD size_t l, size_t g, size_t t)
 	  gBase--;
 	});
   restore_vmi_state(&state);
+  free_parent_vmi_states(&parents);
   unblockGC(0);
   unblockSignals(&mask);
   leaveGC();
