+/* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+The new arguments of the queries outside the running one. A query can run
+Prolog while the arguments of its next call are pushed above its frames:
+I_DEPART on a watched frame calls frameFinished() with them pending, and the
+cleanup handler and frame_finished listeners run in queries of their own.
+Those arguments belong to no frame. mark_stacks() and sweep_stacks() find
+them through get_vmi_state() on every parent query; a stack shift has to
+relocate them the same way, or the call receives the pre-shift address of
+each compound its arguments hold. The states are taken before the stacks
+move, as the running query's is, because get_vmi_state() reads the frames.
+- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
+
+typedef struct parent_vm_states
+{ vm_state     *states;			/* parents with new arguments */
+  size_t	count;			/* entries in states */
+  size_t	allocated;		/* entries allocated */
+} parent_vm_states;
+
+static void
+get_parent_vmi_states(parent_vm_states *parents)
+{ GET_LD
+  QueryFrame qf;
+  size_t depth = 0;
+
+  parents->states = NULL;
+  parents->count = parents->allocated = 0;
+
+  for(qf = LD->query; qf && qf->parent; qf = qf->parent)
+    depth++;
+  if ( depth == 0 )
+    return;
+
+  parents->states = allocHeapOrHalt(depth*sizeof(vm_state));
+  parents->allocated = depth;
+  for(qf = LD->query; qf && qf->parent; qf = qf->parent)
+  { QueryFrame pqf = qf->parent;
+
+    if ( pqf->registers.fr )
+    { vm_state *state = &parents->states[parents->count];
+
+      get_vmi_state(pqf, state);
+      if ( state->lNext )
+	parents->count++;
+    }
+  }
+}
+
+static void
+free_parent_vmi_states(parent_vm_states *parents)
+{ if ( parents->states )
+    freeHeap(parents->states, parents->allocated*sizeof(vm_state));
+}
+
+
 /* - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
