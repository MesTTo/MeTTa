diff --git a/packages/clib/uuid.pl b/packages/clib/uuid.pl
index 979f8d7..f4af526 100644
--- a/packages/clib/uuid.pl
+++ b/packages/clib/uuid.pl
@@ -63,6 +63,15 @@ versions.  Some typical calls are given below:
 @see https://en.wikipedia.org/wiki/Universally_unique_identifier
 */
 
+% A statically linked build has no load_foreign_library/1 and carries the C
+% half, when it was built with OSSP UUID, as the extension uuid; one built
+% without it keeps the Prolog alternative below.
+link_uuid :-
+    current_predicate(system:'$activate_static_extension'/1),
+    !,
+    catch('$activate_static_extension'(uuid),
+          error(existence_error(foreign_extension, _), _),
+          true).
 link_uuid :-
     catch(load_foreign_library(foreign(uuid)), error(_,_), true).
 
