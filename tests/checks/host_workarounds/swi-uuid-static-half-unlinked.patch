+# uuid's C half rests on OSSP UUID alone, which a statically linked build
+# links as readily as a shared one, so it is built wherever LibUUID is
+# found, the WebAssembly build included.
+if(LIBUUID_FOUND)
+  clib_plugin(uuid
+	      C_SOURCES uuid.c
+	      C_LIBS ${UUID_LIBRARY}
+	      C_INCLUDE_DIR ${LIBUUID_INCLUDE_DIR}
+	      PL_LIBS uuid.pl)
+else()
+  swipl_plugin(uuid
+	       PL_LIBS uuid.pl)
+endif()
+
