+/* True when the thread or engine tid is suspended beneath this engine on
+ * its OS thread: it holds this engine, directly or through other engines,
+ * in engine_next/2 or engine_post/2,3, which record it as the caller for
+ * as long as the nested run lasts.  It runs again only once this engine
+ * returns, so waiting for a table it owns never ends, and is_deadlock()
+ * cannot see that, because the owner waits for no table.  Engines
+ * switched with PL_set_engine() from C record no caller, and a claim
+ * there waits as before.
+ * Time: one step per engine suspended beneath this one on its OS thread.
+ */
+
+#define owner_suspended_beneath(tid) LDFUNC(owner_suspended_beneath, tid)
+static bool
+owner_suspended_beneath(DECL_LD int tid)
+{ for(const PL_local_data_t *ld = LD->thread.caller; ld; ld = ld->thread.caller)
+  { if ( ld->thread.info->pl_tid == tid )
+      return true;
+  }
+
+  return false;
+}
+
+#define owner_beneath_error(atrie) LDFUNC(owner_beneath_error, atrie)
+static int
+owner_beneath_error(DECL_LD trie *atrie)
+{ term_t variant;
+
+  DEBUG(MSG_TABLING_SHARED,
+	print_answer_table(atrie, "owner %d is suspended beneath us",
+			   atrie->tid));
+
+  return ( (variant=PL_new_term_ref()) &&
+	   unify_trie_term(atrie->data.variant, NULL, variant) &&
+	   PL_error(NULL, 0,
+		    "the thread or engine completing this table is "
+		    "suspended beneath this call on the same OS thread",
+		    ERR_PERMISSION, ATOM_wait, ATOM_shared_table, variant) );
+}
