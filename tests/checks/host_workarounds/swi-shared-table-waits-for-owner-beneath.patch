@@ -108,6 +109,151 @@ test(prepare_after_another_thread_reevaluated, Xs == [1,2]) :-
 
 :- end_tests(shared_reeval).
 
+% A shared table's owner can be suspended beneath its claimant on one OS
+% thread: it holds the claimant, directly or through other engines, in
+% engine_next/2 and runs again only once the claimant returns.  Such a
+% claim raises a permission error rather than wait forever.  An owner on
+% another OS thread, or one suspended beneath nothing, is waited for.
+
+:- begin_tests(shared_beneath,
+               [ condition(current_prolog_flag(threads, true))
+               ]).
+
+:- table sb/1 as shared.
+:- dynamic sb_depth/1.
+
+% sb/1 asks for itself from an engine sb_depth/1 engines beneath the one
+% completing it; depth 0 is the ordinary recursive call.
+sb(X) :-
+    sb_depth(Depth),
+    beneath(Depth, sb(_)),
+    X = 1.
+sb(2).
+
+beneath(0, Goal) :-
+    !,
+    forall(Goal, true).
+beneath(Depth, Goal) :-
+    Depth1 is Depth-1,
+    in_engine(true, beneath(Depth1, Goal), _).
+
+in_engine(Template, Goal, Answer) :-
+    engine_create(Template, Goal, Engine),
+    call_cleanup(engine_next(Engine, Answer), engine_destroy(Engine)).
+
+sb_answers(Depth, Xs) :-
+    setup_call_cleanup(
+        asserta(sb_depth(Depth), Ref),
+        findall(X, sb(X), Xs0),
+        erase(Ref)),
+    msort(Xs0, Xs).
+
+% Goal raises the permission error for the table of Variant.
+refused(Goal, Variant) :-
+    catch(Goal,
+          error(permission_error(wait, shared_table, _:Variant), _),
+          true),
+    nonvar(Variant).
+
+test(recursion_in_the_owner, Xs == [1,2]) :-
+    abolish_all_tables,
+    sb_answers(0, Xs).
+test(an_owner_thread_beneath, Variant =@= sb(_)) :-
+    abolish_all_tables,
+    refused(sb_answers(1, _), Variant).
+test(an_owner_engine_beneath, Variant =@= sb(_)) :-
+    abolish_all_tables,
+    refused(in_engine(Xs, sb_answers(1, Xs), _), Variant).
+test(an_owner_three_engines_beneath, Variant =@= sb(_)) :-
+    abolish_all_tables,
+    refused(sb_answers(3, _), Variant).
+test(a_refused_table_is_fresh_again, Xs == [1,2]) :-
+    abolish_all_tables,
+    refused(sb_answers(1, _), _),
+    sb_answers(0, Xs).
+
+:- table sw/1 as shared.
+
+sw(X) :-
+    thread_send_message(sw_events, owning),
+    thread_get_message(sw_gate, open),
+    X = 1.
+sw(2).
+
+test(an_owner_on_another_thread_is_waited_for, Xs == [1,2]) :-
+    abolish_all_tables,
+    setup_call_cleanup(
+        ( message_queue_create(_, [alias(sw_events)]),
+          message_queue_create(_, [alias(sw_gate)]) ),
+        ( thread_create(findall(X, sw(X), _), Owner),
+          thread_get_message(sw_events, owning),
+          thread_create(( thread_get_message(sw_events, claiming),
+                          sleep(0.05),
+                          thread_send_message(sw_gate, open) ),
+                        Opener),
+          in_engine(Ys, ( thread_send_message(sw_events, claiming),
+                          findall(Y, sw(Y), Ys) ),
+                    Xs0),
+          thread_join(Owner),
+          thread_join(Opener) ),
+        ( message_queue_destroy(sw_events),
+          message_queue_destroy(sw_gate) )),
+    msort(Xs0, Xs).
+
+:- table sy/1 as shared.
+
+sy(X) :-
+    engine_yield(owning),
+    X = 1.
+sy(2).
+
+test(a_yielded_owner_is_waited_for, Xs == [1,2]) :-
+    abolish_all_tables,
+    engine_create(Ys, findall(Y, sy(Y), Ys), Owner),
+    setup_call_cleanup(
+        message_queue_create(Events),
+        ( engine_next(Owner, owning),
+          thread_create(( thread_get_message(Events, claiming),
+                          sleep(0.05),
+                          engine_next(Owner, _) ),
+                        Resumer),
+          in_engine(Zs, ( thread_send_message(Events, claiming),
+                          findall(Z, sy(Z), Zs) ),
+                    Xs0),
+          thread_join(Resumer) ),
+        ( message_queue_destroy(Events),
+          engine_destroy(Owner) )),
+    msort(Xs0, Xs).
+
+:- table si/1 as (incremental,shared).
+:- dynamic si_d/1 as incremental.
+:- dynamic si_depth/1.
+
+si(X) :-
+    si_d(X).
+si(X) :-
+    si_depth(Depth),
+    beneath(Depth, si(_)),
+    X = 0.
+
+si_answers(Depth, Xs) :-
+    setup_call_cleanup(
+        asserta(si_depth(Depth), Ref),
+        findall(X, si(X), Xs0),
+        erase(Ref)),
+    msort(Xs0, Xs).
+
+test(a_reevaluating_owner_beneath, Variant =@= si(_)) :-
+    abolish_all_tables,
+    retractall(si_d(_)),
+    assertz(si_d(1)),
+    si_answers(0, [0,1]),
+    assertz(si_d(2)),
+    refused(si_answers(1, _), Variant),
+    retractall(si_d(_)).
+
+:- end_tests(shared_beneath).
+
 :- else.                                % no library(time) or no threads.
 
 test_shared_units.
