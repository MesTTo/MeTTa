+
+Clauses erased before  the fill are left out, but  a reader whose view
+predates the erase still sees them:  a frame called just before it, or
+a transaction  that started  before it  (whose snapshot  lasts as long
+as the transaction).  An index that existed at  the erase keeps such a
+clause until  clause GC.  The new index  records the latest  erase it
+left out in `complete_from`, and index_serves() makes older readers read
+the clause list instead.  Every eraser sets `generation.erased` before
+CL_ERASED.  An erase at a transaction-local generation is of a clause
+the transaction asserted itself, which nobody sees after the erase.
 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - */
 
 static ClauseIndex
 fill_clause_index(ClauseIndex ci, ClauseList clist, IndexContext ctx)
-{ for(ClauseRef cref = clist->first_clause; cref; cref = cref->next)
-  { if ( isoff(cref->value.clause, CL_ERASED) )
-    { if ( !addClauseToIndex(ci, cref->value.clause, CL_END) )
+{ gen_t complete_from = 0;
+
+  for(ClauseRef cref = clist->first_clause; cref; cref = cref->next)
+  { Clause cl = cref->value.clause;
+
+    if ( isoff(cl, CL_ERASED) )
+    { if ( !addClauseToIndex(ci, cl, CL_END) )
       { ci->invalid = true;
 	completed_index(ci);
 	deleteIndex(ctx->predicate, clist, ci);
 	return NULL;
       }
+    } else
+    { gen_t erased;
+
+      MEMORY_ACQUIRE();
+      erased = cl->generation.erased;
+      if ( erased < GEN_TRANSACTION_BASE && erased > complete_from )
+	complete_from = erased;
     }
   }
 
-  ci->resize_above = ci->size*2;
-  ci->resize_below = ci->size/4;
+  ci->resize_above  = ci->size*2;
+  ci->resize_below  = ci->size/4;
+  ci->complete_from = complete_from;
 
   completed_index(ci);
   if ( !consider_better_index(ci->speedup, clist->number_of_clauses) )
