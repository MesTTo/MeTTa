+/* The generation at which the reader in `ctx` sees the clauses of other
+ * threads.  A frame inside a transaction carries a generation local to
+ * the transaction, but reads committed clauses as of the transaction's
+ * start (see visibleClause() and transaction_visible_clause()).
+ */
+
+#define reader_view(ctx) LDFUNC(reader_view, ctx)
+static inline gen_t
+reader_view(DECL_LD const IndexContext ctx)
+{ gen_t gen = ctx->generation;
+
+  if ( unlikely(LD->transaction.gen_base && gen >= LD->transaction.gen_base) )
+    return LD->transaction.gen_start;
+
+  return gen;
+}
+
+/* True if `ci` holds every clause visible at `view`.  fill_clause_index()
+ * sets `complete_from` before it completes the index, so a reader that
+ * has seen the index complete reads the final value.
+ */
+
+static inline bool
+index_serves(const ClauseIndex ci, gen_t view)
+{ MEMORY_ACQUIRE();
+  return view >= ci->complete_from;
+}
