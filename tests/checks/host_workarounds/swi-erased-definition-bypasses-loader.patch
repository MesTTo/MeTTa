+/* True if a call must resolve the definition first: the predicate is not
+   declared and has no definition, or is a clause predicate whose live clause
+   count is zero.  A definition abolished while an older frame keeps its
+   logical update view still links its erased clauses, so the raw pointer
+   alone reported it defined, the loader (exception/3, autoload) was never
+   consulted and the supervisor then found no clause and raised. */
+#define undefinedForCall(def) LDFUNC(undefinedForCall, def)
+static inline bool
+undefinedForCall(DECL_LD Definition def)
+{ if ( ison(def, PROC_DEFINED) )
+    return false;
+  if ( !def->impl.any.defined )
+    return true;
+  return ( isoff(def, P_FOREIGN|P_THREAD_LOCAL) &&
+	   def->impl.clauses.number_of_clauses == 0 );
+}
+
 #define getProcDefinedDefinition(def) LDFUNC(getProcDefinedDefinition, def)
 static inline Definition
 getProcDefinedDefinition(DECL_LD Definition def)
-{ if ( !def->impl.any.defined && isoff(def, PROC_DEFINED) )
+{ if ( undefinedForCall(def) )
     def = trapUndefined(def);
 
