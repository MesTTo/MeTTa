new file mode 100644
index 0000000..6604a1e
--- /dev/null
+++ b/tests/tabling/test_engine_shared.pl
@@ -0,0 +1,366 @@
+/*  Part of SWI-Prolog
+
+    Shared tables between the engines of a build without threads.
+
+    Redistribution and use in source and binary forms, with or without
+    modification, are permitted provided that the conditions of the
+    SWI-Prolog license (BSD-2) are met.
+*/
+
+:- module(test_engine_shared,
+          [ test_engine_shared/0
+          ]).
+
+/** <module> Shared tables between the engines of a build without threads
+
+A build without threads runs its engines one at a time on one thread, so
+an engine that meets a shared table another engine is completing cannot
+block as a thread does: the owner only runs once the claimant hands the
+thread back.  '$tbl_variant_table'/6 and its siblings answer wait(Owner)
+and tabling_wait/2 calls prolog:tabling_wait/1.  This file plays the
+embedding host: its hook yields tabling_wait(Reason) to whoever runs the
+engine, and schedule/3 resumes a parked engine once another one made
+progress, as the host's scheduler does.  The randomised case is
+test_shared1.pl's deadlock and abolish test with engines for threads and
+a yield where it sleeps.
+
+A threaded build is skipped: its claimant blocks on a condition variable,
+which an engine sharing the owner's thread never gets to signal.
+*/
+
+:- if(\+ current_prolog_flag(threads, true)).
+
+:- use_module(library(plunit)).
+:- use_module(library(lists)).
+:- use_module(library(apply)).
+:- use_module(library(random)).
+
+test_engine_shared :-
+    run_tests([ engine_shared ]).
+
+:- multifile
+    prolog:tabling_wait/1.
+
+prolog:tabling_wait(Reason) :-
+    engine_self(_),
+    engine_yield(tabling_wait(Reason)).
+
+%!  step
+%
+%   A suspension point inside a tabled evaluation, as a host operation
+%   awaiting a promise is: an engine yields `step`, the main engine runs
+%   on.
+
+step :-
+    (   engine_self(_)
+    ->  engine_yield(step)
+    ;   true
+    ).
+
+:- table p/1 as shared.
+
+p(X) :-
+    flag(p_runs, N, N+1),
+    step,
+    member(X, [a,b,c]).
+
+:- table (pp/1, qq/1) as shared.
+
+max(10).
+
+pp(Y) :- step, qq(X), max(Max), X < Max, Y is X+1.
+pp(0).
+qq(Y) :- step, pp(X), max(Max), X < Max, Y is X+1.
+qq(0).
+
+:- dynamic d/1 as incremental.
+:- table r/1 as (incremental, shared).
+
+r(X) :-
+    flag(r_runs, N, N+1),
+    d(X),
+    step.
+
+%   d/1 is written here rather than in a test body, which plunit runs in
+%   the unit's own module.
+
+set_d(Xs) :-
+    retractall(d(_)),
+    forall(member(X, Xs), assertz(d(X))).
+
+add_d(X) :-
+    assertz(d(X)).
+
+%   Here too: table_statistics/3 qualifies its variant with the module
+%   it is called from, and r/1's table belongs to this one.
+
+r_complete_calls(N) :-
+    table_statistics(r(_), complete_call, N).
+
+:- table t/0 as shared.
+
+t :- step, fail.
+
+:- table m(_, max) as shared.
+
+m(a, X) :- step, member(X, [1,3,2]).
+
+fresh_p :-
+    abolish_all_tables,
+    flag(p_runs, _, 0).
+
+runs(Flag, N) :-
+    flag(Flag, N, N).
+
+%!  drain(+Engine, -Answer) is det.
+%
+%   Run Engine past its step/0 yields until it answers.  Answer is the
+%   tabling_wait(Reason) event if the engine parks instead.
+
+drain(E, Answer) :-
+    engine_next(E, Event),
+    (   Event == step
+    ->  drain(E, Answer)
+    ;   Answer = Event
+    ).
+
+sorted_answers(E, Sorted) :-
+    drain(E, Answers),
+    msort(Answers, Sorted).
+
+%!  schedule(+Engines, +Options, -Answers) is det.
+%
+%   Run Engines, each a findall/3 that answers a list, until all have
+%   answered.  An engine that yields tabling_wait(owner(_)) is parked
+%   until another engine makes progress, which is any event other than a
+%   wait, and tabling_wait(restart) wakes the parked ones as it parks
+%   itself, because it just gave its tables up.  When nothing is left
+%   runnable, every parked engine is woken.  Answers is in the order of
+%   Engines, with `destroyed` for an engine the schedule destroyed.
+%   Options:
+%
+%     - random(true)
+%       Pick the next engine at random rather than round robin.
+%     - destroy(P)
+%       Destroy the engine just stepped with probability P.
+%     - abolish(P)
+%       Call abolish_all_tables/0 from the main engine with probability P
+%       before each step.
+%     - budget(N)
+%       Fail after N steps rather than loop.
+
+schedule(Es, Options, Answers) :-
+    findall(E-runnable, member(E, Es), States0),
+    option(budget(Budget), Options, 100000),
+    schedule_(States0, Options, Budget, States),
+    maplist(state_answer(States), Es, Answers).
+
+state_answer(States, E, Answer) :-
+    memberchk(E-State, States),
+    (   State = done(Answer)
+    ->  true
+    ;   Answer = State
+    ).
+
+schedule_(States, _, _, States) :-
+    \+ ( member(_-S, States), (S == runnable ; S == parked) ),
+    !.
+schedule_(States0, Options, Budget, States) :-
+    Budget > 0,
+    Budget1 is Budget - 1,
+    (   include([_-S]>>(S == runnable), States0, Runnable),
+        Runnable \== []
+    ->  States1 = States0
+    ;   maplist(wake, States0, States1),
+        include([_-S]>>(S == runnable), States1, Runnable)
+    ),
+    pick(Runnable, Options, E-_),
+    maybe_abolish(Options),
+    engine_next_reified(E, Event),
+    event_state(Event, State, Progress),
+    set_state(States1, E, State, States2),
+    (   Progress == true
+    ->  maplist(wake, States2, States3)
+    ;   States3 = States2
+    ),
+    maybe_destroy(E, State, Options, States3, States4),
+    schedule_(States4, Options, Budget1, States).
+
+pick(Runnable, Options, Pick) :-
+    (   option(random(true), Options)
+    ->  random_member(Pick, Runnable)
+    ;   Runnable = [Pick|_]
+    ).
+
+maybe_abolish(Options) :-
+    (   option(abolish(P), Options),
+        maybe(P)
+    ->  abolish_all_tables
+    ;   true
+    ).
+
+maybe_destroy(E, State, Options, States0, States) :-
+    (   State \= done(_),
+        option(destroy(P), Options),
+        maybe(P)
+    ->  engine_destroy(E),
+        set_state(States0, E, done(destroyed), States)
+    ;   States = States0
+    ).
+
+event_state(the(step), runnable, true) :- !.
+event_state(the(tabling_wait(owner(_))), parked, false) :- !.
+event_state(the(tabling_wait(restart)), parked, true) :- !.
+event_state(the(Answers), done(Answers), true) :- !.
+event_state(no, done(no), true).
+event_state(throw(Error), _, _) :-
+    throw(Error).
+
+wake(E-parked, E-runnable) :- !.
+wake(State, State).
+
+set_state([], _, _, []).
+set_state([E0-S0|T0], E, S, [E0-S1|T]) :-
+    (   E0 == E
+    ->  S1 = S
+    ;   S1 = S0
+    ),
+    set_state(T0, E, S, T).
+
+findall_engine(Template, Goal, E) :-
+    engine_create(L, findall(Template, Goal, L), E).
+
+:- begin_tests(engine_shared, [sto(rational_trees)]).
+
+test(one_table_for_every_engine, Runs == 1) :-
+    fresh_p,
+    findall_engine(X, p(X), A),
+    sorted_answers(A, [a,b,c]),
+    findall_engine(Y, p(Y), B),
+    sorted_answers(B, [a,b,c]),
+    runs(p_runs, Runs).
+
+test(a_claimant_waits_for_the_owner, [As, Bs, Runs] == [[a,b,c], [a,b,c], 1]) :-
+    fresh_p,
+    findall_engine(X, p(X), A),
+    engine_next(A, step),                       % A owns p's incomplete table
+    findall_engine(Y, p(Y), B),
+    engine_next(B, tabling_wait(owner(_))),     % B parks
+    sorted_answers(A, As),
+    sorted_answers(B, Bs),
+    runs(p_runs, Runs).
+
+test(nothing_suspends_the_main_engine,
+     error(permission_error(wait, shared_table, _))) :-
+    fresh_p,
+    findall_engine(X, p(X), A),
+    engine_next(A, step),
+    call_cleanup(p(_), engine_destroy(A)).
+
+test(a_destroyed_owner_hands_the_table_back, [Bs, Runs] == [[a,b,c], 2]) :-
+    fresh_p,
+    findall_engine(X, p(X), A),
+    engine_next(A, step),
+    findall_engine(Y, p(Y), B),
+    engine_next(B, tabling_wait(owner(_))),
+    engine_destroy(A),
+    sorted_answers(B, Bs),
+    runs(p_runs, Runs).
+
+test(a_table_abolished_while_owned_goes_on_completion,
+     [As, Bs, Runs] == [[a,b,c], [a,b,c], 2]) :-
+    fresh_p,
+    findall_engine(X, p(X), A),
+    engine_next(A, step),
+    abolish_all_tables,
+    sorted_answers(A, As),
+    findall_engine(Y, p(Y), B),
+    sorted_answers(B, Bs),
+    runs(p_runs, Runs).
+
+test(a_deadlock_between_engines_resolves, Answers == [L, L]) :-
+    abolish_all_tables,
+    numlist(0, 10, L),
+    findall_engine(X, pp(X), A),
+    findall_engine(Y, qq(Y), B),
+    schedule([A, B], [], Answers0),
+    maplist(msort, Answers0, Answers).
+
+test(a_reevaluating_owner_is_waited_for, [As, Bs, Runs] == [[1,2], [1,2], 2]) :-
+    abolish_all_tables,
+    set_d([1]),
+    flag(r_runs, _, 0),
+    findall_engine(X0, r(X0), E0),
+    sorted_answers(E0, [1]),
+    add_d(2),                                   % invalidates r/1
+    findall_engine(X1, r(X1), A),
+    engine_next(A, step),                       % A re-evaluates r/1
+    findall_engine(Y, r(Y), B),
+    engine_next(B, tabling_wait(owner(_))),
+    sorted_answers(A, As),
+    sorted_answers(B, Bs),
+    runs(r_runs, Runs).
+
+% A threaded host counts a re-evaluating call as one call to a completed
+% table, where a private table counts two: its re-evaluated table answers
+% from the trie rather than from the clause the completion compiled.  The
+% counter keeps what earlier tests counted, so this reads its steps.
+test(a_reevaluation_counts_one_completed_call, Steps == [1, 1, 1]) :-
+    abolish_all_tables,
+    set_d([1]),
+    r_complete_calls(C0),
+    findall(X0, r(X0), _),
+    r_complete_calls(C1),
+    add_d(2),                                   % invalidates r/1
+    findall(X1, r(X1), _),                      % re-evaluates it
+    r_complete_calls(C2),
+    findall(X2, r(X2), _),
+    r_complete_calls(C3),
+    maplist([A-B, D]>>(D is A-B), [C1-C0, C2-C1, C3-C2], Steps).
+test(tnot_waits_for_the_owner, [As, Bs] == [[], [true]]) :-
+    abolish_all_tables,
+    findall_engine(x, t, A),
+    engine_next(A, step),
+    findall_engine(R, (tnot(t) -> R = true ; R = false), B),
+    engine_next(B, tabling_wait(owner(_))),
+    drain(A, As),
+    drain(B, Bs).
+
+test(a_moded_table_is_shared, [As, Bs, M] == [[3], [3], 3]) :-
+    abolish_all_tables,
+    findall_engine(X, m(a, X), A),
+    engine_next(A, step),
+    findall_engine(Y, m(a, Y), B),
+    engine_next(B, tabling_wait(owner(_))),
+    drain(A, As),
+    drain(B, Bs),
+    m(a, M).                                    % complete: answers from its trie
+
+test(random_interleavings, forall(between(1, 40, Seed))) :-
+    set_random(seed(Seed)),
+    abolish_all_tables,
+    numlist(0, 10, L),
+    random_between(2, 5, N),
+    length(Es, N),
+    maplist(random_engine, Es),
+    schedule(Es, [random(true), destroy(0.02), abolish(0.05)], Answers),
+    forall(member(Answer, Answers),
+           (   Answer == destroyed
+           ->  true
+           ;   msort(Answer, Sorted),
+               assertion(Sorted == L)
+           )).
+
+random_engine(E) :-
+    (   maybe
+    ->  findall_engine(X, pp(X), E)
+    ;   findall_engine(X, qq(X), E)
+    ).
+
+:- end_tests(engine_shared).
+
+:- else.
+
+test_engine_shared.
+
+:- endif.
