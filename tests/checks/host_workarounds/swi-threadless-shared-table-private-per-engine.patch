 restart_abstract_tabling(Closure, Wrapper, Worker) :-
     tdebug(user_goal(Wrapper, Goal)),
     tdebug(deadlock, 'Deadlock running ~p; retrying', [Goal]),
-    sleep(0.000001),
+    deadlock_backoff(Wrapper),
     start_abstract_tabling(Closure, Wrapper, Worker).
 
+%!  deadlock_backoff(+Goal)
+%
+%   We gave up our component to break a deadlock; give the thread or
+%   engine we deadlocked with the opportunity to grab our table.  A
+%   thread sleeps a very tiny amount: without, it is common that we
+%   re-grab the table within our time slice and before the kernel
+%   managed to wakeup the other thread.  An engine of a build without
+%   threads cannot sleep that opportunity into existence, because the
+%   other engine only runs once this one hands the thread back, so it
+%   suspends through tabling_wait/2.
+
+deadlock_backoff(Goal) :-
+    (   current_prolog_flag(threads, true)
+    ->  sleep(0.000001)
+    ;   tabling_wait(restart, Goal)
+    ).
+
+%!  tabling_wait(+Reason, +Goal)
+%
+%   Suspend an engine of a build without threads that cannot go on with
+%   the shared table Goal needs.  A thread in that position blocks until
+%   the owner completes the table; an engine cannot, because the owner
+%   only makes progress once this engine hands the thread back.  Reason
+%   is owner(Owner) when the engine with tabling id Owner is completing
+%   or re-evaluating the table, and `restart` after this engine gave up
+%   its own tables to break a deadlock.  The embedding host defines
+%   prolog:tabling_wait/1 to suspend this engine until other engines
+%   made progress, after which the caller claims the table again.  Where
+%   no hook suspends the engine, this raises a permission error rather
+%   than use the table incomplete or compute a private copy of it.
+
+:- multifile
+    prolog:tabling_wait/1.
+
+tabling_wait(Reason, Goal) :-
+    (   prolog:tabling_wait(Reason)
+    ->  true
+    ;   tabling_wait_refused(Reason, Message),
+        throw(error(permission_error(wait, shared_table, Goal),
+                    context(tabling_wait/2, Message)))
+    ).
+
+tabling_wait_refused(owner(Owner), Message) :-
+    format(string(Message),
+           'engine ~w is completing this shared table and nothing \c
+            suspended this engine to wait for it (prolog:tabling_wait/1)',
+           [Owner]).
+tabling_wait_refused(restart,
+                     'this engine gave up its tables to break a deadlock \c
+                      and nothing suspended it to let the other engine go \c
+                      first (prolog:tabling_wait/1)').
+
