diff --git a/src/pl-wam.c b/src/pl-wam.c
index c8bb996..5adcc1a 100644
--- a/src/pl-wam.c
+++ b/src/pl-wam.c
@@ -3224,6 +3224,16 @@ PL_current_query(void)
   return 0;
 }
 
+/* A foreign yield (PL_yield_address()) makes PL_next_solution() return
+   PL_S_YIELD to whoever opened the query.  engine_create() opens its
+   query with PL_Q_ALLOW_YIELD for engine_yield/1 (I_YIELD), but
+   engine_next() takes no other yield, so that query is marked
+   PL_Q_INTERACTOR and cannot yield to foreign code. */
+static inline bool
+takes_foreign_yield(const QueryFrame qf)
+{ return ison(qf, PL_Q_ALLOW_YIELD) && !ison(qf, PL_Q_INTERACTOR);
+}
+
 bool
 PL_can_yield(void)
 { GET_LD
@@ -3231,7 +3241,7 @@ PL_can_yield(void)
   return ( HAS_LD &&
 	   LD->query &&
 	   LD->query->magic == QID_MAGIC &&
-	   ison(LD->query, PL_Q_ALLOW_YIELD) );
+	   takes_foreign_yield(LD->query) );
 }
 
