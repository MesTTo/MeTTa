diff --git a/src/os/pl-ctype.c b/src/os/pl-ctype.c
index e9fc518..5ce398e 100644
--- a/src/os/pl-ctype.c
+++ b/src/os/pl-ctype.c
@@ -873,7 +873,17 @@ init_locale(void)
   { char *enc;
 
     if ( (enc = setlocale(LC_CTYPE, NULL)) )
-      rc = enc_from_locale(enc);
+    { rc = enc_from_locale(enc);
+      /* The C and POSIX locales name no character set worth reading
+	 source in: they are what a service or a container runs under
+	 when none is set.  As Python's UTF-8 mode does for the same
+	 case, read and write UTF-8 there rather than ASCII, so a UTF-8
+	 source compiles the same under every locale and a QLF written
+	 under one does not poison a later boot under another. */
+      if ( rc == ENC_ANSI &&
+	   (strcmp(enc, "C") == 0 || strcmp(enc, "POSIX") == 0) )
+	rc = ENC_UTF8;
+    }
   } else if ( rc == ENC_UNKNOWN )
   { rc = ENC_ISO_LATIN_1;
     DEBUG(0, Sdprintf("Failed to set LC_CTYPE locale: %s\n", strerror(errno)));
