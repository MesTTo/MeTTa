 #define SIZEOF_PROC (sizeof(struct procedure) + sizeof(struct definition))
 
+/* A procedure's own new definition of fd in m: one reference, the
+   procedure's, and zeroed argument info.  Both definitions a procedure
+   comes to own are made here, lookupProcedure()'s and the one
+   abolishProcedure() makes when it removes an import link, so they cannot
+   differ: with shared at 0, the first of two procedures linking the
+   definition to be unallocated frees it under the other, and
+   update_primary_index() reads the argument info of a new definition. */
+static Definition
+newDefinition(FunctorDef fd, Module m)
+{ Definition def = allocHeapOrHalt(sizeof(*def));
+
+  memset(def, 0, sizeof(*def));
+  def->functor = fd;
+  def->module  = m;
+#if defined(__SANITIZE_ADDRESS__) && defined(HAVE_SANITIZER_LSAN_INTERFACE_H)
+  def->name = strdup(predicateName(def));
+  __lsan_ignore_object(def->name);
+#endif
+  def->shared  = 1;
+  if ( fd->arity > 0 )
+  { def->impl.any.args = allocHeapOrHalt(sizeof(arg_info)*fd->arity);
+    memset(def->impl.any.args, 0, sizeof(arg_info)*fd->arity);
+  } else
+  { def->impl.any.args = NULL;
+  }
+
+  return def;
+}
