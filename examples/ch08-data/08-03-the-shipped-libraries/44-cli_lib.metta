; Purpose: typed options, exact token boundaries and generated command help.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/44-cli_lib.metta; commit=83b7589a6766210414ceca14dfb9846b28c2ef78].
!(import! &self (library lib_string))
!(import! &self (library lib_cli))

(: cli-main (-> Expression Symbol Expression))
(= (cli-main $arguments $duplicates)
   (cli-parse (((opt count) (type integer) (shortflags (n)) (longflags (count count2)) (default 1) (meta "N") (help "Item count"))
               ((opt verbose) (type boolean) (shortflags (v)) (longflags (verbose)) (default False))
               ((opt name) (shortflags (s)) (longflags (name)) (default "guest")))
              $arguments $duplicates))
(= (cli-plus $increment $text) (+ $increment (parse-number $text)))

; Defaults remain typed, and selected occurrences retain their input order.
!(test (cli-types) (boolean integer float atom string metta))
!(test (cli-main () keeplast) (((count 1) (verbose False) (name "guest")) ()))
!(test (cli-main ("--count" "3" "file") keeplast)
       (((verbose False) (name "guest") (count 3)) ("file")))
!(test (cli-main ("-n4" "--name=π🙂" "-v" "input") keeplast)
       (((count 4) (name "π🙂") (verbose True)) ("input")))
!(test (cli-main ("--count2=7" "--no-verbose") keepall)
       (((name "guest") (count 7) (verbose False)) ()))
!(test (cli-main ("-n" "2" "--name=a" "--count=3") keepfirst)
       (((verbose False) (count 2) (name "a")) ()))
!(test (cli-main ("-n" "2" "--name=a" "--count=3") keeplast)
       (((verbose False) (name "a") (count 3)) ()))
!(test (cli-main ("-n" "2" "--name=a" "--count=3") keepall)
       (((verbose False) (count 2) (name "a") (count 3)) ()))
!(test (cli-main ("--verbose=false" "-vtrue" "--no-verbose") keepall)
       (((count 1) (name "guest") (verbose False) (verbose True) (verbose False)) ()))

; Empty values, dash-led data and the terminator have distinct representations.
!(test (cli-main ("--name" "") keeplast)
       (((count 1) (verbose False) (name "")) ()))
!(test (cli-main ("--name=") keeplast)
       (((count 1) (verbose False) (name "")) ()))
!(test (cli-main ("--name=-v") keeplast)
       (((count 1) (verbose False) (name "-v")) ()))
!(test (cli-main ("-s--count") keeplast)
       (((count 1) (verbose False) (name "--count")) ()))
!(test (cli-main ("--count" "-3") keeplast)
       (((verbose False) (name "guest") (count -3)) ()))
!(test (cli-main ("before" "--" "--count" "3" "") keeplast)
       (((count 1) (verbose False) (name "guest")) ("before" "--count" "3" "")))
!(test (cli-parse () ("-2" "-1.5" "-" "") keepall) (() ("-2" "-1.5" "-" "")))
!(test (cli-parse () ("--" "--" "") keepall) (() ("--" "")))
!(test (let $text (string-from-codes (97 0 98))
         (let $argument (string-join "" ("--name=" $text))
           (let $parsed (cli-main ($argument) keeplast)
             (=alpha $parsed (((count 1) (verbose False) (name $text)) ()))))) True)
!(test (cli-main ("--name=a=b=c") keeplast)
       (((count 1) (verbose False) (name "a=b=c")) ()))
!(test (cli-parse (((opt missing) (longflags (missing)))) () keepall) (() ()))
!(test (cli-parse (((opt symbol) (type atom) (default _))
                   ((opt text) (default "_"))) () keepall) (((symbol _) (text "_")) ()))
!(test (cli-parse (((opt short) (shortflags (x)))
                   ((opt long) (longflags (x)))) ("-x" "left" "--x" "right") keepall)
       (((short "left") (long "right")) ()))
!(test (cli-parse (((opt digit) (type integer) (shortflags ("2")))) ("-2" "7") keepall)
       (((digit 7)) ()))
!(test (cli-parse (((opt mark) (longflags (9?)))) ("--9?=yes") keepall)
       (((mark "yes")) ()))
!(test (cli-parse (((opt verbose) (type boolean) (longflags (verbose)))
                   ((opt named) (longflags (no-verbose)))) ("--no-verbose" "literal") keepall)
       (((named "literal")) ()))
!(test (cli-parse (((opt ratio) (type float) (longflags (ratio)))) ("--ratio=1.25") keepall)
       (((ratio 1.25)) ()))
!(test (cli-parse (((opt mode) (type atom) (longflags (mode)))) ("--mode=scan") keepall)
       (((mode scan)) ()))

; A literal reader and an ordinary function cover structured and custom values.
!(test (cli-parse (((opt value) (type metta) (longflags (value)))) ("--value=(+ 1 2)") keepall)
       (quote (((value (+ 1 2))) ())))
!(test (cli-parse (((opt value) (type metta) (longflags (value)))) ("--value=()") keepall)
       (((value ())) ()))
!(test (let $parsed (cli-parse (((opt value) (type metta) (longflags (value))))
                               ("--value=(row $x $x)") keepall)
         (=alpha $parsed (((value (row $a $a))) ()))) True)
!(test (cli-parse (((opt size) (type (parse (Annotated Number (Gt 0)) parse-number)) (longflags (size)) (default 1)))
                  ("--size=3") keepall) (((size 3)) ()))
!(test (cli-parse (((opt size) (type (parse (Annotated Number (Gt 0)) parse-number)) (longflags (size)) (default 1)))
                  () keepall) (((size 1)) ()))
!(test (cli-parse (((opt text) (type (parse String (|-> ($x) (string-upper $x)))) (longflags (text))))
                  ("--text=hello") keepall) (((text "HELLO")) ()))
!(test (cli-parse (((opt size) (type (parse Number (cli-plus 10))) (longflags (size))))
                  ("--size=5") keepall) (((size 15)) ()))
!(test (let $arguments (quote ("--count=9")) (cli-main $arguments keeplast))
       (((verbose False) (name "guest") (count 9)) ()))
!(test (let $arguments (cli-arguments!) (get-metatype $arguments)) Expression)

; Help derives from declarations, preserving their descriptions and defaults.
!(test (cli-help ()) "")
!(test (cli-help (((opt hidden) (default "local")))) "")
!(test (string-contains (cli-help (((opt count) (type integer) (shortflags (n)) (longflags (count)) (default 1) (meta "N") (help "Item count")))) "--count") True)
!(test (string-contains (cli-help (((opt count) (type integer) (shortflags (n)) (default 1) (meta "N") (help "Item count")))) "N:integer=1") True)
!(test (string-contains (cli-help (((opt text) (longflags (text)) (default "π") (help ("First line" "Second line"))))) "Second line") True)
!(test (string-contains (cli-help (((opt text) (type (parse String (|-> ($x) (empty)))) (longflags (text))))) "String") True)

; Refusals name the offending option and preserve the underlying conversion error.
!(test (let $error (catch (cli-main ("--count" "bad") keeplast))
         (unify $error (Error $ball $context)
           (and (string-contains (repr $ball) "--count")
                (string-contains (repr $context) "declared type")) False)) True)
!(test (if-error (catch (cli-main ("--name") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-main ("--name" "--verbose") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-main ("--unknown") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-main ("--bad?") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-main ("-n=3") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-main ("-vn") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-main ("--count=bad" "--count=3") keeplast)) refused fine) refused)
!(test (if-error (catch (cli-parse () () unknown)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x)) ((opt x))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type integer) (type integer))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (longflags (same))) ((opt y) (longflags (same)))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (longflags ("bad name")))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (wat 1))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((type string))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type unknown))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type integer) (default "bad"))) () keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type metta) (longflags (x)))) ("--x=1 2") keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type (parse (Annotated Number (Gt 0)) parse-number)) (longflags (x)))) ("--x=0") keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type (parse String (|-> ($x) (empty)))) (longflags (x)))) ("--x=a") keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type (parse Number (|-> ($x) (superpose (1 2))))) (longflags (x)))) ("--x=a") keepall)) refused fine) refused)
!(test (if-error (catch (cli-parse (((opt x) (type (parse Number (|-> ($x) "wrong"))) (longflags (x)))) ("--x=a") keepall)) refused fine) refused)
