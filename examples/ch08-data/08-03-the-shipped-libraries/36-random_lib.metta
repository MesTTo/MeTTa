; Purpose: inspect, rewrite and run sample programs through ordinary MeTTa control.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/36-random_lib.metta; commit=1d0b78a359f58de49f2f98bed50a6480d56cd5f6].
!(import! &self (library lib_random))

; A sampler is code held as an expression. eval draws once; repeat owns repetition.
!(test (let $sample (random-normal 0 1) (get-metatype $sample)) Expression)
!(test (get-type random-normal) (-> Number Number Expression))
!(test (let $drawn (random-choice ("only")) (eval $drawn)) "only")
!(test (size-atom (let $drawn (random-choice ((+ 1 2))) (eval $drawn))) 3)
!(test (random-shuffle! ()) ())
!(test (with-seed 42 (sort-atom (random-shuffle! (1 1 2 3)))) (1 1 2 3))
!(test (== (with-seed 42 (random-shuffle! (1 2 3 4)))
           (with-seed 42 (random-shuffle! (1 2 3 4)))) True)
!(test (random-sample! () 0) ())
!(test (with-seed 42 (sort-atom (random-sample! (1 1 2 3) 4))) (1 1 2 3))
!(test (let $choice (random-choice ("x")) (collapse (repeat 3 $choice))) ("x" "x" "x"))
!(test (with-seed 42 (size-atom (random-sample! (1 2 3 4 5) 3))) 3)
!(test (with-seed 42 (random-sample! ("x" "x") 2)) ("x" "x"))
!(test (== (with-seed 9 (let $drawn (random-choice (1 2 3 4)) (eval $drawn)))
           (with-seed 9 (let $drawn (random-choice (1 2 3 4)) (eval $drawn)))) True)
!(test (let $choice (random-choice ($x))
         (== (map-atom (0 1 2) $i (eval $choice)) (quote ($x $x $x)))) True)
!(test (let $sample (with-seed 42 (random-sample! ($x $x) 2))
         (== $sample (quote ($x $x)))) True)
!(test (let $sample (random-sample! ((Error data code)) 1)
         (== $sample (quote ((Error data code))))) True)

; Binding the program validates even when repeat will produce no samples.
!(test (let $sample (random-normal 0 1) (collapse (repeat 0 $sample))) ())
!(test (let $sample (random-uniform 4 4) (collapse (repeat 3 $sample))) (4.0 4.0 4.0))
!(test (let $drawn (random-normal 7 0) (eval $drawn)) 7.0)
!(test (let $drawn (random-lognormal 0 0) (eval $drawn)) 1.0)
!(test (let $drawn (random-triangular 3 3 3) (eval $drawn)) 3.0)
!(test (let $sample (random-bernoulli 0) (collapse (repeat 2 $sample))) (False False))
!(test (let $sample (random-bernoulli 1) (collapse (repeat 2 $sample))) (True True))
!(test (let $sample (random-normal 0 1)
         (with-seed 42 (size-atom (collapse (repeat 5 $sample))))) 5)
!(test (let $sample (random-normal 0 1)
         (== (with-seed 42 (collapse (repeat 4 $sample)))
             (with-seed 42 (collapse (repeat 4 $sample))))) True)
!(test (let $sample (random-normal 0 1)
         (== (with-seed 42 (once (repeat 100 $sample)))
             (with-seed 42 (eval $sample)))) True)
!(test (let $drawn (random-normal (math-rational 1 2) 0) (eval $drawn)) 0.5)

; The existing numeric and generator basis covers every distribution family.
!(test (with-seed 11 (let $x (let $drawn (random-uniform -4 9) (eval $drawn))
                      (and (>= $x -4) (<= $x 9)))) True)
!(test (with-seed 11 (math-class (let $drawn (random-normal 0 1) (eval $drawn)))) normal)
!(test (with-seed 11 (> (let $drawn (random-lognormal 0 1) (eval $drawn)) 0)) True)
!(test (with-seed 11 (> (let $drawn (random-exponential 2) (eval $drawn)) 0)) True)
!(test (with-seed 11 (let $x (let $drawn (random-triangular -4 9 2) (eval $drawn))
                      (and (>= $x -4) (<= $x 9)))) True)
!(test (with-seed 11 (> (let $drawn (random-gamma 2 3) (eval $drawn)) 0)) True)
!(test (with-seed 11 (let $x (let $drawn (random-beta 2 5) (eval $drawn))
                      (and (> $x 0) (< $x 1)))) True)
!(test (with-seed 11 (let* (($sample (random-bernoulli 0.25)) ($value (eval $sample)))
                      (get-type $value))) Bool)
!(test (with-seed 11 (>= (let $drawn (random-pareto 3) (eval $drawn)) 1)) True)
!(test (with-seed 11 (> (let $drawn (random-weibull 2 3) (eval $drawn)) 0)) True)
!(test (with-seed 42 (let $drawn (random-gamma 1.0e308 1) (eval $drawn))) 1.0e308)
!(test (with-seed 42 (let $drawn (random-beta 1.0e308 1.0e308) (eval $drawn))) 0.5)
!(test (with-seed 2 (let $drawn (random-gamma 0.001 1) (eval $drawn))) 0.0)
!(test (with-seed 2 (> (let $drawn (random-gamma 0.001 1.0e300) (eval $drawn)) 0)) True)
!(test (with-seed 42 (let $drawn (random-weibull 1.0e308 1.0e308) (eval $drawn))) 1.0e308)
!(test (math-class (let $drawn (random-lognormal 1000 0) (eval $drawn))) infinite)
!(test (let $drawn (random-lognormal -1000 0) (eval $drawn)) 0.0)

; Programs are ordinary metagraph data, so storage and rewriting need no registry.
!(let $sample (random-normal 12 0) (add-atom &self (saved-sampler $sample)))
!(test (let $sample (match &self (saved-sampler $code) $code) (eval $sample)) 12.0)
!(test (let $sample (random-uniform 2 10)
         (let ($head $entropy $low $high) (quote $sample)
           (let $rewritten (quote ($head 0.25 $low $high))
             (eval $rewritten)))) 4.0)
!(test (let $make (match &self (= (random-normal $mean $deviation) $body)
                   (quote (|-> ($mean $deviation) $body)))
         (let $constructor (eval $make)
           (let $sample ($constructor 9 0) (eval $sample)))) 9.0)
!(test (collapse (let $sample (random-normal (superpose (1 2)) 0)
                   (eval $sample))) (1.0 2.0))
!(test (let $sample (quote (superpose (a b))) (collapse (repeat 2 $sample))) (a b a b))
!(test (let* (($a (random-normal 2 0)) ($b (random-uniform 3 3))
              ($sum (quote (+ (eval $a) (eval $b)))))
         (eval $sum)) 5.0)

; Refuse malformed populations, counts and numeric parameters before drawing.
!(test (if-error (catch (random-choice ())) refused fine) refused)
!(test (if-error (catch (random-shuffle! "text")) refused fine) refused)
!(test (if-error (catch (random-sample! () 1)) refused fine) refused)
!(test (if-error (catch (random-sample! (1 2) 3)) refused fine) refused)
!(test (if-error (catch (random-sample! (1) -1)) refused fine) refused)
!(test (if-error (catch (random-sample! (1) 1.0)) refused fine) refused)
!(test (if-error (catch (random-normal 0 -1)) refused fine) refused)
!(test (if-error (catch (random-uniform 2 1)) refused fine) refused)
!(test (if-error (catch (random-triangular 0 1 2)) refused fine) refused)
!(test (if-error (catch (random-exponential 0)) refused fine) refused)
!(test (if-error (catch (random-gamma -1 2)) refused fine) refused)
!(test (if-error (catch (random-beta 2 0)) refused fine) refused)
!(test (if-error (catch (random-bernoulli 1.1)) refused fine) refused)
!(test (if-error (catch (random-pareto 0)) refused fine) refused)
!(test (if-error (catch (random-weibull 0 1)) refused fine) refused)
!(test (if-error (catch (random-normal "x" 1)) refused fine) refused)
!(test (if-error (catch (random-normal (math-real inf ()) 1)) refused fine) refused)
!(test (if-error (catch (let $sample (random-normal 0 -1) (repeat 0 $sample)))
          refused fine) refused)
