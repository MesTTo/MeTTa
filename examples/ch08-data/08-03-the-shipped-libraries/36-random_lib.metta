; Purpose: occurrence sampling, distribution values and seeded answer streams.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/36-random_lib.metta; commit=505b45e1d9184608c818a8a4fdba5cf6406bf3e7].
!(import! &self (library lib_random))

; Populations and distribution forms are held data. Bind a computed value first.
; Equal values still occupy distinct positions when sampling without replacement.
!(test (size-atom (random-distributions)) 10)
!(test (index-atom (random-distributions) 0) (random-distribution uniform ("low" "high")))
!(test (random-choice! ("only")) "only")
!(test (size-atom (random-choice! ((+ 1 2)))) 3)
!(test (random-shuffle! ()) ())
!(test (with-seed 42 (sort-atom (random-shuffle! (1 1 2 3)))) (1 1 2 3))
!(test (== (with-seed 42 (random-shuffle! (1 2 3 4)))
           (with-seed 42 (random-shuffle! (1 2 3 4)))) True)
!(test (random-sample! () 0 True) ())
!(test (random-sample! () 0 False) ())
!(test (with-seed 42 (sort-atom (random-sample! (1 1 2 3) 4 False))) (1 1 2 3))
!(test (with-seed 42 (random-sample! ("x") 3 True)) ("x" "x" "x"))
!(test (with-seed 42 (size-atom (random-sample! (1 2 3 4 5) 3 False))) 3)
!(test (with-seed 42 (random-sample! ("x" "x") 2 False)) ("x" "x"))
!(test (== (with-seed 9 (random-choice! (1 2 3 4)))
           (with-seed 9 (random-choice! (1 2 3 4)))) True)

; Count controls the answer stream; collapse and once already provide collection
; and prefix consumption. Degenerate distributions do not consume the generator.
!(test (collapse (random-draw! (normal 0 1) 0)) ())
!(test (collapse (random-draw! (uniform 4 4) 3)) (4.0 4.0 4.0))
!(test (random-draw! (normal 7 0) 1) 7.0)
!(test (random-draw! (lognormal 0 0) 1) 1.0)
!(test (random-draw! (triangular 3 3 3) 1) 3.0)
!(test (collapse (random-draw! (bernoulli 0) 2)) (False False))
!(test (collapse (random-draw! (bernoulli 1) 2)) (True True))
!(test (with-seed 42 (size-atom (collapse (random-draw! (normal 0 1) 5)))) 5)
!(test (== (with-seed 42 (collapse (random-draw! (normal 0 1) 4)))
           (with-seed 42 (collapse (random-draw! (normal 0 1) 4)))) True)
!(test (== (with-seed 42 (once (random-draw! (normal 0 1) 100)))
           (with-seed 42 (random-draw! (normal 0 1) 1))) True)
!(test (let $mean (math-rational 1 2)
         (random-draw! (normal $mean 0) 1)) 0.5)

; Every family uses the same generator. The continuous laws retain floating
; precision, including rounded endpoints, subnormals and overflow to infinity.
!(test (with-seed 11 (let $x (random-draw! (uniform -4 9) 1)
                      (and (>= $x -4) (<= $x 9)))) True)
!(test (with-seed 11 (math-class (random-draw! (normal 0 1) 1))) normal)
!(test (with-seed 11 (> (random-draw! (lognormal 0 1) 1) 0)) True)
!(test (with-seed 11 (> (random-draw! (exponential 2) 1) 0)) True)
!(test (with-seed 11 (let $x (random-draw! (triangular -4 9 2) 1)
                      (and (>= $x -4) (<= $x 9)))) True)
!(test (with-seed 11 (> (random-draw! (gamma 2 3) 1) 0)) True)
!(test (with-seed 11 (let $x (random-draw! (beta 2 5) 1)
                      (and (> $x 0) (< $x 1)))) True)
!(test (with-seed 11 (let $x (random-draw! (bernoulli 0.25) 1) (get-type $x))) Bool)
!(test (with-seed 11 (>= (random-draw! (pareto 3) 1) 1)) True)
!(test (with-seed 11 (> (random-draw! (weibull 2 3) 1) 0)) True)
!(test (with-seed 42 (random-draw! (gamma 1.0e308 1) 1)) 1.0e308)
!(test (with-seed 42 (random-draw! (beta 1.0e308 1.0e308) 1)) 0.5)
!(test (with-seed 2 (random-draw! (gamma 0.001 1) 1)) 0.0)
!(test (with-seed 2 (> (random-draw! (gamma 0.001 1.0e300) 1) 0)) True)
!(test (with-seed 42 (random-draw! (weibull 1.0e308 1.0e308) 1)) 1.0e308)
!(test (math-class (random-draw! (lognormal 1000 0) 1)) infinite)

; Refusals identify invalid populations, counts, constructor shapes or domains.
!(test (if-error (catch (random-choice! ())) refused fine) refused)
!(test (if-error (catch (random-shuffle! "text")) refused fine) refused)
!(test (if-error (catch (random-sample! () 1 True)) refused fine) refused)
!(test (if-error (catch (random-sample! (1 2) 3 False)) refused fine) refused)
!(test (if-error (catch (random-sample! (1) -1 True)) refused fine) refused)
!(test (if-error (catch (random-draw! (missing 1) 0)) refused fine) refused)
!(test (if-error (catch (random-draw! (normal 0) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (normal 0 -1) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (uniform 2 1) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (triangular 0 1 2) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (exponential 0) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (gamma -1 2) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (beta 2 0) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (bernoulli 1.1) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (pareto 0) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (weibull 0 1) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (normal "x" 1) 1)) refused fine) refused)
!(test (if-error (catch (random-draw! (normal 0 1) -1)) refused fine) refused)
