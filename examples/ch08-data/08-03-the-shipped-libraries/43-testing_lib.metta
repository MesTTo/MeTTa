; Purpose: finite input families, counted assertions and first witnesses.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/43-testing_lib.metta; commit=WORKTREE].
!(import! &self (library lib_combinatorics))
!(import! &self (library lib_testing))

; Lists reuse the Cartesian generator; a domain is an ordinary held call.
!(test (collapse (cartesian-power (a b) 1)) ((a) (b)))
!(test (collapse (test-integers -2 2)) (-2 -1 0 1 2))
!(test (collapse (test-integers 3 3)) (3))
!(test (collapse (test-integers 3 2)) ())
!(test (collapse (test-integers 100000000000000000000 100000000000000000002))
       (100000000000000000000 100000000000000000001 100000000000000000002))
!(test (collapse (test-choices (a a "π"))) (a a "π"))
!(test (collapse (test-choices ())) ())
!(test (size-atom (test-choices ((+ 1 2)))) 3)
!(test (collapse (test-choices (()))) (()))
!(test (let $items (collapse (test-integers 1 3))
         (collapse (test-choices $items))) (1 2 3))
!(test (collapse (test-lists (test-integers 0 1) 0 2))
       (() (0) (1) (0 0) (0 1) (1 0) (1 1)))
!(test (collapse (test-lists (test-choices (a a)) 2 2))
       ((a a) (a a) (a a) (a a)))
!(test (collapse (test-lists (test-choices ()) 0 4)) (()))
!(test (collapse (test-lists (test-choices ()) 1 4)) ())
!(test (collapse (test-lists (test-integers 0 1) 2 1)) ())
!(test (collapse (test-lists (test-integers bad bounds) 0 0)) (()))
!(test (collapse (test-lists (test-lists (test-choices (a)) 0 1) 1 1))
       ((()) ((a))))
!(test (let $pair (test-lists (test-choices ((row $x $x))) 2 2)
         (=alpha $pair ((row $a $a) (row $b $b)))) True)

; Expected is the entire answer bag. A Boolean property expects exactly (True).
!(test (test-forall (test-integers -3 3)
         (|-> ($x) (>= (* $x $x) 0)) (True)) 7)
!(test (test-forall (test-lists (test-integers 0 1) 0 3)
         (|-> ($xs) (== (reverse (reverse $xs)) $xs)) (True)) 15)
!(test (test-forall (test-integers 0 4) (<= 0) (True)) 5)
!(test (test-forall (test-choices (a a b)) (|-> ($x) True) (True)) 3)
!(test (test-forall (test-choices ()) (|-> ($x) False) (True)) 0)
!(test (test-forall (test-integers 1 2)
         (|-> ($x) (superpose (2 1 1))) (1 2 1)) 2)
!(test (test-forall (test-integers 1 2) (|-> ($x) (empty)) ()) 2)
!(test (test-forall (test-choices ((+ 1 2))) (|-> ($x) $x) ((+ 1 2))) 1)
!(test (test-forall (test-choices ((row $x $x)))
         (|-> ($value) (=alpha $value (row $y $y))) (True)) 1)

; A witness stops at the first matching input and otherwise has no answers.
!(test (test-witness (test-integers 0 5) (|-> ($x) (>= $x 3)) (True)) 3)
!(test (collapse (test-witness (test-integers 0 5) (|-> ($x) (>= $x 3)) (True))) (3))
!(test (collapse (test-witness (test-integers 0 2) (|-> ($x) (>= $x 3)) (True))) ())
!(test (collapse (test-witness (test-choices ()) (|-> ($x) True) (True))) ())
!(test (test-witness (test-integers 0 5) (|-> ($x) (superpose (2 1 1))) (1 1 2)) 0)
!(test (size-atom (test-witness (test-choices ((+ 1 2))) (|-> ($x) $x) ((+ 1 2)))) 3)
!(test (collapse (test-witness (test-choices (() (a))) size-atom (0))) (()))
!(test (test-forall (test-integers 0 2)
         (|-> ($x) (== (test-witness (test-integers 0 2) (== $x) (True)) $x)) (True)) 3)

; Failure keeps the engine's missing/excess bags and identifies the input.
!(test (let $error (catch (test-forall (test-integers 0 3) (|-> ($x) (< $x 2)) (True)))
         (unify $error (Error $ball $context) (repr $ball) no-error))
       "(metta_assertion_failed (test-forall (test-integers 0 3) ((|-> ($_0) (< $_0 2)) (quote 2)) (true)) (true) (false))")
!(test (if-error (catch (test-forall (test-choices (a)) (|-> ($x) 7) (True))) refused fine) refused)
!(test (if-error (catch (test-forall (test-choices (a)) (|-> ($x) (empty)) (True))) refused fine) refused)
!(test (if-error (catch (test-forall (test-choices (a)) (|-> ($x) (superpose (True True))) (True))) refused fine) refused)
!(test (if-error (catch (test-integers 1.5 2)) refused fine) refused)
!(test (if-error (catch (test-integers 1 inf)) refused fine) refused)
!(test (if-error (catch (test-choices a)) refused fine) refused)
!(test (if-error (catch (test-lists (test-choices (a)) -1 2)) refused fine) refused)
!(test (if-error (catch (test-lists (test-choices (a)) 0 1.5)) refused fine) refused)
!(test (if-error (catch (test-forall (test-choices ()) (|-> ($x) True) True)) refused fine) refused)
!(test (if-error (catch (test-witness (test-choices ()) (|-> ($x) True) True)) refused fine) refused)
!(test (if-error (catch (test-lists (test-integers bad 3) 1 1)) refused fine) refused)
!(test (if-error (catch (test-forall (test-choices (a)) (|-> ($x) (test-integers bad 3)) (True))) refused fine) refused)
