; Purpose: exact finite descriptive statistics and explicit sample domains.
; [tested: sh test.sh examples/ch08-data/08-03-the-shipped-libraries/37-statistics_lib.metta; commit=WORKTREE].
!(import! &self (library lib_statistics))

; Accumulate the stored numbers exactly, then round only a floating result.
!(test (stats-sum ()) 0)
!(test (stats-sum (1 2 3)) 6)
!(test (stats-sum (1.0e308 1 -1.0e308)) 1.0)
!(test (math-class (stats-sum (1.0e308 1.0e308))) infinite)
!(test (stats-mean (1 2 3)) 2)
!(test (math-ratio (stats-mean (1 2))) (3 2))
!(test (stats-mean (1.0e308 1.0e308)) 1.0e308)
!(test (stats-mean (1.0e308 1 -1.0e308)) (math-float (math-rational 1 3)))
!(test (stats-harmonic-mean (40 60)) 48)
!(test (stats-harmonic-mean (40.0 60)) 48.0)
!(test (stats-harmonic-mean (0 7)) 0)
!(test (stats-geometric-mean (54 24 36)) 36.0)
!(test (stats-geometric-mean (0 7)) 0.0)
!(test (stats-geometric-mean (1.0e308 1.0e308)) 1.0e308)
!(test (let* (($big (pow-math 2 2000)) ($small (math-rational 1 $big)))
         (stats-geometric-mean ($big $small))) 1.0)

; Quantiles name their interpolation rule. Exclusive endpoints extrapolate.
!(test (stats-median (9 1 4)) 4)
!(test (math-ratio (stats-median (1 2))) (3 2))
!(test (stats-median (9.0 1 4)) 4.0)
!(test (stats-quantile (0 10) 0 inclusive) 0)
!(test (stats-quantile (0 10) 1 inclusive) 10)
!(test (math-ratio (stats-quantile (0 10) 0.25 inclusive)) (5 2))
!(test (stats-quantile (0 10) 0 exclusive) -10)
!(test (stats-quantile (0 10) 1 exclusive) 20)
!(test (stats-quantiles (0 4 8) 4 inclusive) (2 4 6))
!(test (stats-quantiles (0 4 8) 4 exclusive) (0 4 8))
!(test (stats-quantiles (7) 4 exclusive) (7 7 7))
!(test (stats-quantiles (7) 1 inclusive) ())
!(test (collapse (stats-mode ("b" "a" "b" "a" "c"))) ("b" "a"))
!(test (once (stats-mode ("b" "a" "b" "a"))) "b")
!(test (collapse (stats-mode (1 1.0))) (1 1.0))
!(test (size-atom (stats-mode ((+ 1 2) (+ 1 2) 9))) 3)

; One degrees-of-freedom parameter covers population, sample and other divisors.
!(test (stats-variance (1 2 3) 1) 1)
!(test (math-ratio (stats-variance (1 2 3) 0)) (2 3))
!(test (stats-variance (1 2 3) 2) 2)
!(test (stats-variance (1000000000.0 1000000001.0 1000000002.0) 1) 1.0)
!(test (stats-variance (7) 0) 0)
!(test (stats-stdev (1 2 3) 1) 1.0)
!(test (stats-stdev (1 3) 0) 1.0)
!(test (math-class (stats-variance (-1.0e308 1.0e308) 0)) infinite)
!(test (stats-stdev (-1.0e308 1.0e308) 0) 1.0e308)
!(test (stats-variance (-1.0e-300 1.0e-300) 0) 0.0)
!(test (stats-stdev (-1.0e-300 1.0e-300) 0) 1.0e-300)
!(test (stats-covariance (1 2 3) (1 3 5) 1) 2)
!(test (math-ratio (stats-covariance (1 2 3) (1 3 5) 0)) (4 3))
!(test (stats-correlation (-1.0e308 1.0e308) (-1.0e308 1.0e308)) 1.0)
!(test (stats-correlation (-1.0e308 1.0e308) (1.0e308 -1.0e308)) -1.0)
!(test (stats-ranks ()) ())
!(test (stats-ranks (30 10 20)) (3 1 2))
!(test (vector-scale (stats-ranks (1 1.0 2)) 2) (3 3 6))
!(test (stats-correlation (stats-ranks (1 4 9)) (stats-ranks (1 2 3))) 1.0)
!(test (stats-regression (0 1 2) (1 5 9) False) (linear-fit 4 1))
!(test (stats-regression (0.0 1 2) (1 5 9) False) (linear-fit 4.0 1.0))
!(test (stats-regression (2) (6) True) (linear-fit 3 0))
!(test (stats-regression (0 1 2) (7 7 7) False) (linear-fit 0 7))

; Refusals check complete data, even when a zero or singleton could return early.
!(test (if-error (catch (stats-mean ())) refused fine) refused)
!(test (if-error (catch (stats-sum (1 "bad"))) refused fine) refused)
!(test (if-error (catch (stats-geometric-mean ())) refused fine) refused)
!(test (if-error (catch (stats-geometric-mean (0 -1))) refused fine) refused)
!(test (if-error (catch (stats-harmonic-mean ())) refused fine) refused)
!(test (if-error (catch (stats-harmonic-mean (0 -1))) refused fine) refused)
!(test (if-error (catch (stats-median ())) refused fine) refused)
!(test (if-error (catch (stats-quantile (1) 2 inclusive)) refused fine) refused)
!(test (if-error (catch (stats-quantile (1) 0.5 missing)) refused fine) refused)
!(test (if-error (catch (stats-quantiles (1) 0 inclusive)) refused fine) refused)
!(test (if-error (catch (stats-quantiles (1) 1 missing)) refused fine) refused)
!(test (if-error (catch (stats-mode ())) refused fine) refused)
!(test (if-error (catch (stats-variance (1) 1)) refused fine) refused)
!(test (if-error (catch (stats-variance (1 2) -1)) refused fine) refused)
!(test (if-error (catch (stats-stdev () 0)) refused fine) refused)
!(test (if-error (catch (stats-covariance (1 2) (1) 0)) refused fine) refused)
!(test (if-error (catch (stats-correlation (1 1) (2 3))) refused fine) refused)
!(test (if-error (catch (stats-correlation (1) (2))) refused fine) refused)
!(test (if-error (catch (stats-regression (1 1) (2 3) False)) refused fine) refused)
!(test (if-error (catch (stats-regression (0) (2) True)) refused fine) refused)
!(test (if-error (catch (stats-regression (1 2) (3) False)) refused fine) refused)
!(test (let $inf (math-real inf ())
         (if-error (catch (stats-mean ($inf))) refused fine)) refused)
